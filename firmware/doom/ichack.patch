diff --git a/src/pico/ichack_trace.S b/src/pico/ichack_trace.S
new file mode 100644
index 0000000..f0fa24e
--- /dev/null
+++ b/src/pico/ichack_trace.S
@@ -0,0 +1,56 @@
+#include "pico/asm_helper.S"
+#include "hardware/regs/addressmap.h"
+#include "hardware/regs/m33.h"
+#include "hardware/regs/powman.h"
+#include "hardware/regs/timer.h"
+#include "ichack_trace.h"
+
+.syntax unified
+.thumb
+.section .text.ichack_trace, "ax", %progbits
+
+.global ichack_trace_sample
+.type ichack_trace_sample, %function
+.thumb_func
+ichack_trace_sample:
+    tst lr, #4
+    ite eq
+    mrseq r0, msp
+    mrsne r0, psp
+    ldr r0, [r0, #24]
+    ldr r1, =(POWMAN_BASE + POWMAN_SCRATCH4_OFFSET)
+    str r0, [r1]
+    ldr r1, =TIMER1_BASE
+    movs r0, #1
+    str r0, [r1, #TIMER_INTR_OFFSET]
+    ldr r0, [r1, #TIMER_TIMERAWL_OFFSET]
+    ldr r2, =ICHACK_TRACE_SAMPLE_US
+    adds r0, r0, r2
+    str r0, [r1, #TIMER_ALARM0_OFFSET]
+    bx lr
+
+.global isr_hardfault
+.type isr_hardfault, %function
+.thumb_func
+isr_hardfault:
+    cpsid i
+    ldr r1, =(POWMAN_BASE + POWMAN_SCRATCH4_OFFSET)
+    ldr r2, =(PPB_BASE + M33_CFSR_OFFSET)
+    ldr r2, [r2]
+    str r2, [r1, #4]
+    movs r0, #0
+    movw r3, #0x1818
+    tst r2, r3
+    bne 1f
+    tst lr, #4
+    ite eq
+    mrseq r0, msp
+    mrsne r0, psp
+    ldr r0, [r0, #24]
+1:
+    str r0, [r1]
+    ldr r1, =(POWMAN_BASE + POWMAN_SCRATCH1_OFFSET)
+    movs r0, #'F'
+    str r0, [r1]
+2:
+    b 2b
diff --git a/src/pico/ichack_trace.h b/src/pico/ichack_trace.h
new file mode 100644
index 0000000..01843e3
--- /dev/null
+++ b/src/pico/ichack_trace.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#define ICHACK_TRACE_SAMPLE_US 100000
+
+#ifndef __ASSEMBLER__
+#include "hardware/irq.h"
+#include "hardware/structs/powman.h"
+#include "hardware/structs/timer.h"
+#include "hardware/watchdog.h"
+
+#define ICHACK_TRACE_MAGIC 0x444f4f4du
+
+extern void ichack_trace_sample(void);
+
+static inline void ichack_trace_start(void) {
+    powman_hw->scratch[1] = 'B';
+    powman_hw->scratch[2] = 0;
+    powman_hw->scratch[3] = 0;
+    powman_hw->scratch[4] = 0;
+    powman_hw->scratch[5] = 0;
+    powman_hw->scratch[0] = ICHACK_TRACE_MAGIC;
+    irq_set_exclusive_handler(TIMER1_IRQ_0, ichack_trace_sample);
+    timer1_hw->intr = 1;
+    timer1_hw->inte = 1;
+    timer1_hw->alarm[0] = timer1_hw->timerawl + ICHACK_TRACE_SAMPLE_US;
+    irq_set_enabled(TIMER1_IRQ_0, true);
+    watchdog_enable(3000, false);
+}
+
+static inline void ichack_trace_stage(char stage) {
+    powman_hw->scratch[1] = stage;
+}
+
+static inline void ichack_trace_flags(uint32_t flags) {
+    powman_hw->scratch[3] |= flags;
+}
+
+static inline void ichack_trace_frame(uint32_t tic) {
+    powman_hw->scratch[2] = tic;
+    ichack_trace_stage('V');
+    watchdog_update();
+}
+#endif
