# Keep current deliverables in Git; ignore intermediate meshes, caches and logs.
/build/*
!/build/appearance-handoff.zip
!/build/exports/
/build/exports/*
!/build/exports/*.stl
!/build/exports/*-checks.json
!/build/exports/frame-section-dimensions.json
!/build/exports/accessories/
/build/exports/accessories/*
!/build/exports/accessories/*.stl
!/build/previews/
/build/previews/*
!/build/previews/*.png
!/build/board/
/build/board/*
!/build/board/*.png
!/build/board/*.svg
!/build/print-pack/
/.venv/
__pycache__/
*.py[cod]

# PlatformIO firmware build output and downloaded dependencies.
/firmware/.pio/

# KiCad working files
*-backups/
*.lck
*.kicad_prl
fp-info-cache
